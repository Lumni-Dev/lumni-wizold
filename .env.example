# Postgres (Supabase session/transaction pooler; libpq reads the PG* family)
PGHOST=
PGPORT=6543
PGUSER=
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require

# Sessions ("userId.expiry.hmac" cookies are signed with this)
SESSION_SECRET=

# Google Identity Services (public client id, shared by browser and server)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Mail (Hostinger SMTP; welcome, deletion code and farewell letters)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# Stripe (test keys locally; production reads the LIVE pair when VERCEL_ENV=production)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Cron (mining reset at 06:00 São Paulo)
CRON_SECRET=

# Web Push (tavern notifications; generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:wizold@lumni.dev.br

# API CORS (comma-separated extra origins; localhost is allowed in development)
NEXT_PUBLIC_SITE_URL=https://wizold.lumni.dev.br
ALLOWED_ORIGINS=

# Benches (optional): smoke target and load bench size
SMOKE_BASE=http://localhost:3000
LOAD_PLAYERS=8
