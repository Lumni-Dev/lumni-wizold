# PostgreSQL connection for scripts/migrate.mjs and the future data adapter.
# Copy to .env.local and fill in; .env.local is never committed.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=troque-aqui
PGDATABASE=wizold-prod

# Signs the session cookie; any long random string.
SESSION_SECRET=troque-por-64-hex-aleatorios

# Google Identity Services client (public id, also inlined in the browser bundle).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
