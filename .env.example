# Postgres (Supabase session/transaction pooler; libpq reads the PG* family)
PGHOST=
PGPORT=6543
PGUSER=
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require

# Sessions ("userId.expiry.hmac" cookies are signed with this)
SESSION_SECRET=

# Google Identity Services (public client id, shared by browser and server)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Mail (Hostinger SMTP; welcome, deletion code and farewell letters)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# Stripe (test keys locally; production reads the LIVE pair when VERCEL_ENV=production)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Benches (optional): smoke target and load bench size
SMOKE_BASE=http://localhost:3000
LOAD_PLAYERS=8

# Admin ceilings (optional; defaults live in code, NEXT_PUBLIC_* so the client build reads them too)
# Changing one on Vercel only takes effect on the next deploy, because the client inlines them at build time.
NEXT_PUBLIC_MESSAGE_COOLDOWN_MS=10000
NEXT_PUBLIC_MAX_ROOM_MEMBERS=20
NEXT_PUBLIC_MAX_PACK=20
NEXT_PUBLIC_MAX_ENHANCEMENT=1000
NEXT_PUBLIC_PET_MAX_LEVEL=1000
NEXT_PUBLIC_MAX_CHARACTER_LEVEL=1000
