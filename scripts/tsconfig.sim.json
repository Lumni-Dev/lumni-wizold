{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../.sim",
    "rootDir": "../src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["../src/models/**/*.ts", "../src/shared/**/*.ts"],
  "exclude": ["../src/models/repositories/**/*.ts"]
}
