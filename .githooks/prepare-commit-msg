#!/bin/sh
# Strip Cursor co-author trailers from every commit message.
COMMIT_MSG_FILE=$1

case "$2,$3" in
  merge,*|squash,*) exit 0 ;;
esac

if [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

tmp="${COMMIT_MSG_FILE}.cursor-strip"
grep -viE '^Co-authored-by:[[:space:]]*Cursor([[:space:]]|<|$)' "$COMMIT_MSG_FILE" |
  grep -viE '^Co-authored-by:.*cursoragent@cursor\.com' >"$tmp" || true

mv "$tmp" "$COMMIT_MSG_FILE"
exit 0
